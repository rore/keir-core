<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.keir</groupId><artifactId>keir-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>keir-java-host</artifactId>
  <dependencies>
    <dependency><groupId>dev.keir</groupId><artifactId>keir-runtime-java</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.12.2</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources><resource><directory>${project.basedir}/../../conformance/single-effect</directory><targetPath>single-effect</targetPath><includes><include>scenarios.json</include></includes></resource><resource><directory>${project.basedir}/../../conformance/generic-hooks</directory><targetPath>generic-hooks</targetPath></resource></resources>
    <testResources>
      <testResource><directory>${project.basedir}/../../conformance/read-and-decide</directory><targetPath>read-and-decide</targetPath></testResource>
      <testResource><directory>${project.basedir}/../../conformance/single-effect</directory><targetPath>single-effect</targetPath></testResource>
      <testResource><directory>${project.basedir}/../../conformance/generic-hooks</directory><targetPath>generic-hooks</targetPath></testResource>
    </testResources>
    <plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
      <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
        <createDependencyReducedPom>false</createDependencyReducedPom>
        <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>dev.keir.examples.JavaHost</mainClass></transformer></transformers>
        <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude></excludes></filter></filters>
      </configuration></execution></executions>
    </plugin>
  </plugins></build>
</project>
