{
  "domain": {
    "fingerprint": "sha256:77c67ad6a82149d461181d5c4ea661763a84b7055c6589bcce8049710362d959",
    "id": "sample.inventory",
    "version": "1"
  },
  "entrypoint": "InventoryArrived",
  "language": "keir/2",
  "name": "adjust-unmatched-labelled-inventory",
  "return": {
    "record": {
      "dueAt": {
        "cel": "due"
      },
      "eligible": {
        "cel": "eligible"
      }
    }
  },
  "steps": [
    {
      "args": {
        "label": {
          "cel": "input.targetLabel"
        },
        "warehouseId": {
          "cel": "input.warehouseId"
        }
      },
      "call": "inventory.findOpen",
      "id": "open"
    },
    {
      "id": "eligible",
      "let": {
        "cel": "input.targetLabel in input.labels && !open.matches && (has(input.enabled) ? input.enabled : true)"
      }
    },
    {
      "id": "due",
      "let": {
        "cel": "has(input.expiresAt) ? input.expiresAt + duration(\"604800s\") : input.occurredAt + duration(\"604800s\")"
      }
    },
    {
      "args": {
        "dueAt": {
          "cel": "due"
        },
        "itemId": {
          "cel": "input.itemId"
        }
      },
      "call": "inventory.adjust",
      "id": "adjusted",
      "onError": {
        "ACCESS_DENIED": {
          "record": {
            "eligible": {
              "literal": false
            }
          }
        }
      },
      "when": "eligible"
    }
  ]
}
