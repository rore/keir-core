{
  "description": "Qualification-only independent expectations; no released numeric contract. ERROR means an escaping pure expression error.",
  "helpers": [
    {"kind":"decimal","input":"100.00","expected":"100"},
    {"kind":"integer","input":"100.00","expected":"100"},
    {"kind":"decimal","input":"-000.000","expected":"0"},
    {"kind":"integer","input":"+00042.000","expected":"42"},
    {"kind":"decimal","input":"00012.34000","expected":"12.34"},
    {"kind":"decimal","input":"0.000000000000000001","expected":"0.000000000000000001"},
    {"kind":"decimal","input":"0.0000000000000000001","expected":"ERROR"},
    {"kind":"integer","input":"12.01","expected":"ERROR"},
    {"kind":"integer","input":"9223372036854775807","expected":"9223372036854775807"},
    {"kind":"integer","input":"-9223372036854775808","expected":"-9223372036854775808"},
    {"kind":"integer","input":"9223372036854775808","expected":"ERROR"},
    {"kind":"decimal","input":"99999999999999999999999999999999999999","expected":"99999999999999999999999999999999999999"},
    {"kind":"decimal","input":"100000000000000000000000000000000000000","expected":"ERROR"},
    {"kind":"decimal","repeat":"0","count":256,"expected":"0"},
    {"kind":"decimal","repeat":"0","count":257,"expected":"ERROR"},
    {"kind":"decimal","input":" 1","expected":"ERROR"},
    {"kind":"decimal","input":"1e2","expected":"ERROR"},
    {"kind":"decimal","input":".5","expected":"ERROR"},
    {"kind":"decimal","input":"1.","expected":"ERROR"},
    {"kind":"decimal","input":"NaN","expected":"ERROR"},
    {"kind":"decimal","input":"Infinity","expected":"ERROR"},
    {"kind":"decimal","input":"١","expected":"ERROR"},
    {"kind":"decimal","input":100,"expected":"ERROR"},
    {"kind":"decimal","input":null,"expected":"ERROR"}
  ],
  "cases": [
    {"id":"scalar","source":"text + \"-ok\"","type":"String","expected":"tenant-ok","timed":true},
    {"id":"integer-add","source":"i + j","type":"Integer","expected":"8","timed":true},
    {"id":"integer-exact-divide","source":"i / j","type":"Integer","expected":"3","timed":true,"counter":"divide_int64"},
    {"id":"integer-inexact","source":"5 / 2","type":"Integer","expected":"ERROR","counter":"divide_int64"},
    {"id":"integer-negative","source":"-6 / 2","type":"Integer","expected":"-3"},
    {"id":"integer-subtract","source":"i - j","type":"Integer","expected":"4"},
    {"id":"integer-multiply","source":"i * j","type":"Integer","expected":"12"},
    {"id":"integer-negate","source":"-i","type":"Integer","expected":"-6"},
    {"id":"integer-less","source":"i < j","type":"Boolean","expected":false},
    {"id":"integer-less-equal","source":"i <= i","type":"Boolean","expected":true},
    {"id":"integer-greater","source":"i > j","type":"Boolean","expected":true},
    {"id":"integer-greater-equal","source":"i >= i","type":"Boolean","expected":true},
    {"id":"integer-zero-divisor","source":"i / 0","type":"Integer","expected":"ERROR"},
    {"id":"integer-max","source":"9223372036854775807","type":"Integer","expected":"9223372036854775807"},
    {"id":"integer-min","source":"-9223372036854775808","type":"Integer","expected":"-9223372036854775808"},
    {"id":"integer-above-double","source":"9007199254740993 + 2","type":"Integer","expected":"9007199254740995"},
    {"id":"integer-add-overflow","source":"9223372036854775807 + 1","type":"Integer","expected":"ERROR"},
    {"id":"integer-subtract-overflow","source":"-9223372036854775808 - 1","type":"Integer","expected":"ERROR"},
    {"id":"integer-multiply-overflow","source":"9223372036854775807 * 2","type":"Integer","expected":"ERROR"},
    {"id":"integer-negate-overflow","source":"-i","type":"Integer","vars":{"i":"-9223372036854775808"},"expected":"ERROR"},
    {"id":"integer-divide-overflow","source":"i / -1","type":"Integer","vars":{"i":"-9223372036854775808"},"expected":"ERROR"},
    {"id":"decimal-add","source":"a + b","type":"Decimal","expected":"3.25","timed":true,"counter":"keir_decimal_add"},
    {"id":"decimal-subtract","source":"a - b","type":"Decimal","expected":"-0.75","counter":"keir_decimal_subtract"},
    {"id":"decimal-multiply","source":"a * b","type":"Decimal","expected":"2.5","timed":true,"counter":"keir_decimal_multiply"},
    {"id":"decimal-divide","source":"a / b","type":"Decimal","expected":"0.625","counter":"keir_decimal_divide"},
    {"id":"decimal-negate","source":"-a","type":"Decimal","expected":"-1.25","counter":"keir_decimal_negate"},
    {"id":"decimal-equal","source":"a == decimal(\"1.25\")","type":"Boolean","expected":true},
    {"id":"decimal-not-equal","source":"a != b","type":"Boolean","expected":true},
    {"id":"decimal-unequal","source":"a == b","type":"Boolean","expected":false},
    {"id":"decimal-less","source":"a < b","type":"Boolean","expected":true,"counter":"keir_decimal_less"},
    {"id":"decimal-less-equal","source":"a <= a","type":"Boolean","expected":true,"counter":"keir_decimal_less_equal"},
    {"id":"decimal-greater","source":"b > a","type":"Boolean","expected":true,"counter":"keir_decimal_greater"},
    {"id":"decimal-greater-equal","source":"a >= a","type":"Boolean","expected":true,"counter":"keir_decimal_greater_equal"},
    {"id":"decimal-tenth","source":"decimal(\"0.1\") + decimal(\"0.2\")","type":"Decimal","expected":"0.3","counter":"keir_decimal_from_string"},
