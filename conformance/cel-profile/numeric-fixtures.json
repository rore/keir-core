    {"id":"rate-chain","source":"decimal(\"0.00001\") / decimal(\"100\") * decimal(\"0.00001\")","type":"Decimal","expected":{"fixed9":"ERROR","fixed18":"0.000000000001","normalized18":"0.000000000001"}},
    {"id":"quote","source":"multiplyRounded(decimal(\"199.95\"), decimal(\"1\") - decimal(\"0.075\"), 2, \"HALF_EVEN\")","type":"Decimal","expected":"184.95"},
    {"id":"range-tradeoff","source":"decimal(\"300000000000000000000\") * decimal(\"0.00001\")","type":"Decimal","expected":{"fixed9":"3000000000000000","fixed18":"ERROR","normalized18":"3000000000000000"}},
