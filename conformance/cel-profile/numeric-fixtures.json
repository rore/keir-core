    {"id":"number-first-and","source":"(1 / 0 == 0) && timestamp(\"9999-12-31T23:59:59.999Z\") + duration(\"1s\") == timestamp(\"9999-12-31T23:59:59.999Z\")","type":"Boolean","expected":"ERROR"},
    {"id":"time-first-or","source":"timestamp(\"9999-12-31T23:59:59.999Z\") + duration(\"1s\") == timestamp(\"9999-12-31T23:59:59.999Z\") || (1 / 0 == 0)","type":"Boolean","expected":"TIME_ERROR"},
    {"id":"number-first-or","source":"(1 / 0 == 0) || timestamp(\"9999-12-31T23:59:59.999Z\") + duration(\"1s\") == timestamp(\"9999-12-31T23:59:59.999Z\")","type":"Boolean","expected":"ERROR"},
    {"id":"time-masked","source":"timestamp(\"9999-12-31T23:59:59.999Z\") + duration(\"1s\") == timestamp(\"9999-12-31T23:59:59.999Z\") || true","type":"Boolean","expected":true}
  ],
  "rejectSources": ["1.5 + 2.5", "1u == 1u", "a.value", "keir.numeric.Decimal{value: \"1\"}", "round(a, i, \"DOWN\")", "round(a, 2, text)", "round(a, 19, \"DOWN\")", "round(a, 2, \"UNKNOWN\")", "decimal(text)", "input.tags.size()", "input.zero", "a == i"],
  "concurrent": [
    {"id":"scalar-lanes","source":"text + \"-ok\"","type":"String"},
    {"id":"integer-lanes","source":"i + 1","type":"Integer"},
