    {"id":"rounded-multiply","source":"multiplyRounded(a, b, 2, \"HALF_EVEN\")","type":"Decimal","expected":"2.5","timed":true,"counter":"keir_decimal_multiply_rounded"},
    {"id":"round-half-even","source":"round(decimal(\"2.345\"), 2, \"HALF_EVEN\")","type":"Decimal","expected":"2.34","counter":"keir_decimal_round"},
    {"id":"round-even-up","source":"round(decimal(\"2.355\"), 2, \"HALF_EVEN\")","type":"Decimal","expected":"2.36"},
    {"id":"round-half-up","source":"round(decimal(\"-2.345\"), 2, \"HALF_UP\")","type":"Decimal","expected":"-2.35"},
    {"id":"round-down","source":"round(decimal(\"-2.349\"), 2, \"DOWN\")","type":"Decimal","expected":"-2.34"},
