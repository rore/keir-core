    {"id":"to-decimal","source":"toDecimal(i)","type":"Decimal","expected":"6","counter":"keir_decimal_from_integer"},
    {"id":"to-integer","source":"toInteger(b)","type":"Integer","expected":"2","counter":"keir_integer_from_decimal"},
    {"id":"to-integer-fraction","source":"toInteger(a)","type":"Integer","expected":"ERROR"},
