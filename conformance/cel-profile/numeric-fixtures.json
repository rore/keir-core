    {"id":"lazy","source":"false ? 1 / 0 : 1","type":"Integer","expected":"1"},
    {"id":"sparse-false","source":"flag ? a : decimal(\"0\")","type":"Decimal","vars":{"flag":false},"omit":["a"],"expected":"0"},
