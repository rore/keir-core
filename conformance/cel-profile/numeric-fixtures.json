    {"id":"quantum-square","source":"decimal(\"0.000000000000000001\") * decimal(\"0.000000000000000001\")","type":"Decimal","expected":"ERROR"},
    {"id":"rounded-quantum","source":"multiplyRounded(decimal(\"0.000000000000000001\"), decimal(\"0.000000000000000001\"), 18, \"HALF_EVEN\")","type":"Decimal","expected":{"fixed9":"ERROR","fixed18":"0","normalized18":"0"}},
    {"id":"rounded-quantum-exact","source":"multiplyRounded(decimal(\"0.000000000000000001\"), decimal(\"0.000000000000000001\"), 18, \"UNNECESSARY\")","type":"Decimal","expected":"ERROR"},
    {"id":"wide-product","source":"multiplyRounded(decimal(\"9999999999999999999\"), decimal(\"0.000000001\"), 2, \"HALF_EVEN\")","type":"Decimal","expected":"10000000000"},
    {"id":"maximum-comparison","source":"a < b","type":"Boolean","vars":{"a":"9999999999999999999","b":"9999999999999999999.000000001"},"expected":true,"timed":true},
