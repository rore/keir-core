    {"id":"bind","bind":"decimal(\"2\")","source":"d + a","type":"Decimal","expected":"3.25"},
    {"id":"expression-only","source":"decimal(\"1\") < decimal(\"2\")","type":"Boolean","expected":true},
    {"id":"expression-only-size","bind":"toDecimal(size(input.tags))","source":"d == decimal(\"2\")","type":"Boolean","vars":{"input":{"flag":false,"text":"","tags":["x","x"]}},"expected":true},
    {"id":"optional-absent","model":"numeric","source":"has(input.maybe) ? input.maybe : decimal(\"7\")","type":"Decimal","expected":"7"},
