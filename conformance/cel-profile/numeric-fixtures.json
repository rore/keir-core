    {"id":"round-negative-even-below-half","source":"round(decimal(\"-2.344\"), 2, \"HALF_EVEN\")","type":"Decimal","expected":"-2.34"},
    {"id":"round-negative-even-above-half","source":"round(decimal(\"-2.346\"), 2, \"HALF_EVEN\")","type":"Decimal","expected":"-2.35"},
    {"id":"round-positive-up-tie","source":"round(decimal(\"2.345\"), 2, \"HALF_UP\")","type":"Decimal","expected":"2.35"},
    {"id":"round-up-below-half","source":"round(decimal(\"2.344\"), 2, \"HALF_UP\")","type":"Decimal","expected":"2.34"},
    {"id":"round-up-above-half","source":"round(decimal(\"2.346\"), 2, \"HALF_UP\")","type":"Decimal","expected":"2.35"},
    {"id":"round-negative-up-below-half","source":"round(decimal(\"-2.344\"), 2, \"HALF_UP\")","type":"Decimal","expected":"-2.34"},
    {"id":"round-negative-up-above-half","source":"round(decimal(\"-2.346\"), 2, \"HALF_UP\")","type":"Decimal","expected":"-2.35"},
    {"id":"round-positive-down","source":"round(decimal(\"2.349\"), 2, \"DOWN\")","type":"Decimal","expected":"2.34"},
    {"id":"round-scale-eighteen","source":"round(decimal(\"2.1\"), 18, \"UNNECESSARY\")","type":"Decimal","expected":"2.1"},
    {"id":"rounded-third","source":"divideRounded(decimal(\"1\"), decimal(\"3\"), 2, \"DOWN\")","type":"Decimal","expected":"0.33"},
    {"id":"rounded-negative-third","source":"divideRounded(decimal(\"-1\"), decimal(\"3\"), 2, \"FLOOR\")","type":"Decimal","expected":"-0.34"},
