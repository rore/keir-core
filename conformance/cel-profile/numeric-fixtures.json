    {"id":"round-ceiling","source":"round(decimal(\"-2.349\"), 2, \"CEILING\")","type":"Decimal","expected":"-2.34"},
    {"id":"round-unnecessary","source":"round(decimal(\"2.34\"), 2, \"UNNECESSARY\")","type":"Decimal","expected":"2.34"},
    {"id":"round-unnecessary-failure","source":"round(decimal(\"2.341\"), 2, \"UNNECESSARY\")","type":"Decimal","expected":"ERROR"},
    {"id":"round-positive-ceiling","source":"round(decimal(\"2.341\"), 2, \"CEILING\")","type":"Decimal","expected":"2.35"},
    {"id":"round-positive-floor","source":"round(decimal(\"2.349\"), 2, \"FLOOR\")","type":"Decimal","expected":"2.34"},
    {"id":"round-zero","source":"round(decimal(\"-0.001\"), 0, \"DOWN\")","type":"Decimal","expected":"0"},
