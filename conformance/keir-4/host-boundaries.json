      "numbers.write": {"version": "1", "effect": "WRITE", "parameters": {
        "integer": {"type": "Integer", "binding": "agent"}, "decimal": {"type": "Decimal", "binding": "agent"},
        "protectedInteger": {"type": "Integer", "binding": "host"}, "protectedDecimal": {"type": "Decimal", "binding": "host"}
      }, "result": "Data", "errors": ["DENIED"]}
