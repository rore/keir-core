{
  "capabilities": {
    "tasks.create": {
      "effect": "WRITE",
      "errors": [
        "CREATE_REJECTED",
        "ACCESS_DENIED",
        "KEY_PAYLOAD_MISMATCH",
        "TEST_ERROR_01",
        "TEST_ERROR_02",
        "TEST_ERROR_03",
        "TEST_ERROR_04",
        "TEST_ERROR_05",
        "TEST_ERROR_06",
        "TEST_ERROR_07",
        "TEST_ERROR_08",
        "TEST_ERROR_09",
        "TEST_ERROR_10",
        "TEST_ERROR_11",
        "TEST_ERROR_12",
        "TEST_ERROR_13",
        "TEST_ERROR_14"
      ],
      "parameters": {
        "actorId": {
          "binding": "host",
          "type": "UserId"
        },
        "projectId": {
          "binding": "agent",
          "type": "ProjectId"
        },
        "title": {
          "binding": "agent",
          "type": "String"
        }
      },
      "result": "CreatedTask",
      "version": "1"
    },
    "tasks.get": {
      "effect": "READ",
      "errors": [
        "TASK_NOT_FOUND",
        "ACCESS_DENIED"
      ],
      "parameters": {
        "actorId": {
          "binding": "host",
          "type": "UserId"
        },
        "taskId": {
          "binding": "agent",
          "type": "TaskId"
        }
      },
      "result": "Task",
      "version": "1"
    }
  },
  "domain": {
    "id": "sample.tasks",
    "version": "4"
  },
  "entrypoints": {
    "TaskCompleted": {
      "consumer": {
        "id": "sample.followup.report",
        "kind": "EVENT_REPORT",
        "version": "1"
      },
      "event": {
        "idType": "EventId",
        "sourceType": "TaskId"
      },
      "input": "TaskCompletedInput",
      "output": "FollowupResult",
      "placement": "AFTER_COMMIT",
      "trigger": "EVENT"
    }
  },
  "format": "keir-dcm/1",
  "hostKey": {
    "source": "requestKey",
    "type": "sample.RequestUuid/1"
  },
  "types": {
    "CreatedTask": {
      "fields": {
        "id": "TaskId"
      },
      "kind": "record"
    },
    "EventId": {
      "base": "String",
      "kind": "nominal"
    },
    "FollowupResult": {
      "fields": {
        "status": "FollowupStatus"
      },
      "kind": "record"
    },
    "FollowupStatus": {
      "kind": "enum",
      "values": [
        "CREATED",
        "NO_OP"
      ]
    },
    "ProjectId": {
      "base": "String",
      "kind": "nominal"
    },
    "Task": {
      "fields": {
        "id": "TaskId",
        "projectId": "ProjectId",
        "status": "TaskStatus"
      },
      "kind": "record"
    },
    "TaskCompletedInput": {
      "fields": {
        "taskId": "TaskId"
      },
      "kind": "record"
    },
    "TaskId": {
      "base": "String",
      "kind": "nominal"
    },
    "TaskStatus": {
      "kind": "enum",
      "values": [
        "OPEN",
        "COMPLETED"
      ]
    },
    "UserId": {
      "base": "String",
      "kind": "nominal"
    }
  }
}
