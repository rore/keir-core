{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keir:schema:artifact:3",
  "title": "Keir decoded artifact structure",
  "description": "Native canonical bytes, external pins, bound model, checked metadata, semantics, budgets and authority remain required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "compiler",
    "environment",
    "sourceDigest",
    "modelRef",
    "entrypoint",
    "expressions",
    "steps",
    "return"
  ],
  "properties": {
    "format": {
      "const": "keir-artifact/3"
    },
    "compiler": {
      "enum": [
        "keir-compiler-java/0.3.0",
        "keir-compiler-java/0.3.1"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "celJava",
        "celNode",
        "protobufJava",
        "protobufNode"
      ],
      "properties": {
        "celJava": {
          "const": "0.14.0"
        },
        "celNode": {
          "const": "0.6.1"
        },
        "protobufJava": {
          "const": "4.35.1"
        },
        "protobufNode": {
          "const": "2.6.2"
        }
      }
    },
    "sourceDigest": {
      "$ref": "#/$defs/digest"
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "domainVersion",
        "format",
        "digest",
        "descriptorRecipe"
      ],
      "properties": {
        "domainId": {
          "$ref": "#/$defs/text"
        },
        "domainVersion": {
          "$ref": "#/$defs/text"
        },
        "format": {
          "const": "keir-dcm/3"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "descriptorRecipe": {
          "const": "keir-record-descriptors/2"
        }
      }
    },
    "entrypoint": {
      "$ref": "#/$defs/id"
    },
    "expressions": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "$ref": "#/$defs/expressionId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/expression"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/call"
          },
          {
            "$ref": "#/$defs/bind"
          }
        ]
      }
    },
    "return": {
      "$ref": "#/$defs/return"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9.]{0,99}(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "expressionId": {
      "type": "string",
      "pattern": "^e(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal",
            "type"
          ],
          "properties": {
            "literal": {
              "type": [
                "boolean",
                "string"
              ],
              "maxLength": 256
            },
            "type": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expr",
            "type"
          ],
          "properties": {
            "expr": {
              "$ref": "#/$defs/expressionId"
            },
            "type": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked",
        "variables",
        "resultType"
      ],
      "properties": {
        "checked": {
          "type": "string",
          "minLength": 4,
          "maxLength": 21848,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
        },
        "variables": {
          "type": "object",
          "required": [
            "input"
          ],
          "maxProperties": 9,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/name"
          }
        },
        "resultType": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "id",
        "capability",
        "version",
        "args",
        "resultType"
      ],
      "properties": {
        "op": {
          "const": "CALL"
        },
        "id": {
          "$ref": "#/$defs/name"
        },
        "capability": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "args": {
          "$ref": "#/$defs/bindings"
        },
        "resultType": {
          "$ref": "#/$defs/name"
        },
        "when": {
          "$ref": "#/$defs/name"
        },
        "onError": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])"
          },
          "additionalProperties": {
            "$ref": "#/$defs/return"
          }
        }
      }
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "id",
        "value",
        "resultType"
      ],
      "properties": {
        "op": {
          "const": "BIND"
        },
        "id": {
          "$ref": "#/$defs/name"
        },
        "value": {
          "$ref": "#/$defs/binding"
        },
        "resultType": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "return": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fields"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/name"
        },
        "fields": {
          "$ref": "#/$defs/bindings"
        }
      }
    }
  }
}
